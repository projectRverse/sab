-- 1. Load Fluent Library & Addons
local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()
local SaveManager = loadstring(game:HttpGet("https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/SaveManager.lua"))()
local InterfaceManager = loadstring(game:HttpGet("https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/InterfaceManager.lua"))()

-- 2. Buat Window Utama
local Window = Fluent:CreateWindow({
    Title = "SAB PIE LOADER V2 NEW",
    SubTitle = "by SAB PIE Team",
    TabWidth = 160,
    Size = UDim2.fromOffset(580, 460),
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.LeftControl
})

-- 3. Membuat Tab Menu (Window 1, 2, 3, & Settings)
local Tabs = {
    SAB = Window:AddTab({ Title = "BEST PIE SAB", Icon = "flame" }),
    Duel = Window:AddTab({ Title = "BEST DUEL", Icon = "swords" }),
    Misc = Window:AddTab({ Title = "MISC", Icon = "box" }),
    Settings = Window:AddTab({ Title = "Settings & Info", Icon = "settings" })
}

----------------------------------------------------------------------
-- DISCORD INFORMATION & INVITE SECTION
----------------------------------------------------------------------
local DiscordLink = "https://discord.gg/RTDXRjfner"

for _, Tab in pairs({Tabs.SAB, Tabs.Duel, Tabs.Misc}) do
    Tab:AddParagraph({
        Title = "Join Our Community!",
        Content = "Join our discord for more script:\n" .. DiscordLink
    })
    Tab:AddButton({
        Title = "Copy Discord Invite Link",
        Description = "Klik untuk menyalin link Discord ke clipboard",
        Callback = function()
            if setclipboard then
                setclipboard(DiscordLink)
                Fluent:Notify({
                    Title = "Discord Link",
                    Content = "Link Discord berhasil disalin!",
                    Duration = 3
                })
            else
                Fluent:Notify({
                    Title = "Error",
                    Content = "Fitur setclipboard tidak didukung oleh eksekutor kamu.",
                    Duration = 3
                })
            end
        end
    })
end

----------------------------------------------------------------------
-- WINDOW 1: BEST PIE SAB SCRIPT
----------------------------------------------------------------------
Tabs.SAB:AddSection("Script List")

local SAB_Scripts = {
    ["Irish Hub V1.1"] = "https://pastebin.com/raw/HW6U98FR",
    ["ViolanceHub.CC"] = "https://pastebin.com/raw/c3U9pqfn",
    ["Brainrot Spawner V1"] = "https://pastebin.com/raw/Q80jRuDD",
    ["Brainrot Spanwer V2"] = "https://pastebin.com/raw/PrSqDkMf",
    ["Auto Buy Carpet"] = "https://pastebin.com/raw/1vMhQL0U",
    ["Auto Grab V1"] = "https://pastebin.com/raw/Ncrn0NWs",
    ["Auto Steal + zeus gear"] = "https://pastebin.com/raw/Vt4QzvSX",
    ["FlashTP ice hub"] = "https://pastebin.com/raw/40vnSnnV",
    ["Nova FlashTP"] = "https://pastebin.com/raw/VmJEpDz1",
    ["Insta Reset"] = "https://pastebin.com/raw/tkUY2HJm",
    ["404 Auto Grab"] = "https://pastebin.com/raw/b6sir6sE"
}

local SAB_List = {}
for name, _ in pairs(SAB_Scripts) do
    table.insert(SAB_List, name)
end
table.sort(SAB_List)

local SelectedSAB = SAB_List[1]

local SABDropdown = Tabs.SAB:AddDropdown("SABSelector", {
    Title = "Pilih SAB Script",
    Values = SAB_List,
    Multi = false,
    Default = 1,
})

SABDropdown:OnChanged(function(Value)
    SelectedSAB = Value
end)

Tabs.SAB:AddButton({
    Title = "Execute Selected SAB Script",
    Description = "Menjalankan script SAB yang dipilih dari menu di atas",
    Callback = function()
        if SAB_Scripts[SelectedSAB] then
            Fluent:Notify({
                Title = "SAB Loader",
                Content = "Executing: " .. SelectedSAB,
                Duration = 3
            })
            task.spawn(function()
                loadstring(game:HttpGet(SAB_Scripts[SelectedSAB]))()
            end)
        end
    end
})

